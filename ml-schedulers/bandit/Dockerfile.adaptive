# ml-schedulers/bandit/Dockerfile.adaptive
# Adaptive Bandit Scheduler with pod eviction support
#
# Build with:
#   eval $(minikube docker-env)
#   docker build -f Dockerfile.adaptive -t bandit-scheduler:v2-adaptive .

FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the NEW adaptive scheduler
COPY adaptive_bandit_scheduler.py .

# Create logs directory
RUN mkdir -p /app/logs

# Environment variables (defaults, overridden by K8s deployment)
ENV SCHEDULER_NAME=bandit-scheduler
ENV WATCH_NAMESPACE=default
ENV LOG_LEVEL=INFO

# Thompson Sampling
ENV INITIAL_ALPHA=1.0
ENV INITIAL_BETA=1.0
ENV WINDOW_SIZE=20
ENV RESET_THRESHOLD=0.4

# Shock simulation (set SIMULATE_REWARDS=true for testing)
ENV SIMULATE_REWARDS=false
ENV SHOCK_ENABLED=true
ENV SHOCK_QUERY=50

# Metrics (real, not simulated)
ENV RAG_APP_METRICS_URL=http://rag-app-service:8000/metrics
ENV METRICS_POLL_INTERVAL=2.0

# Eviction
ENV EVICTION_ENABLED=true
ENV EVICTION_COOLDOWN=30.0
ENV MIN_QUERIES_BEFORE_EVICTION=10
ENV EVICTION_TARGET_LABELS=app=generation

# Run the adaptive scheduler
CMD ["python", "-u", "adaptive_bandit_scheduler.py"]